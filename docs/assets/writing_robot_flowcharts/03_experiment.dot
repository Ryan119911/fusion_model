digraph "03_experiment" {
	bgcolor="#F7F6F2" dpi=160 nodesep=0.5 outputorder=edgesfirst pad=0.35 rankdir=TB ranksep=0.45 splines=polyline
	node [fontcolor="#172725" fontname="Noto Sans CJK SC" fontsize=19 margin="0.22,0.16" penwidth=1.6]
	edge [arrowsize=0.8 color="#657F74" fontcolor="#4C6158" fontname="Noto Sans CJK SC" fontsize=15 penwidth=1.5]
	conditions [label="固定实验条件
统一纸面零点、实心支撑
姿态、速度与上墨流程保持一致" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	design [label="首轮探索：三档重复短线
d = 2.0／2.5／3.0 mm，各 3 条
每条 25 mm；顺序交错、位置均衡" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	collect [label="逐条独立上墨与书写
保存实际指令、位姿与完整原图" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	measure [label="共同尺度测量
行笔宽度与波动
起收笔、拖痕另行记录" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	separable [label="档间差异能否与
同档波动区分？" color="#A87926" fillcolor="#FFF6E3" margin="0.15,0.10" shape=diamond style=filled]
	fit [label="拟合局部下压—笔宽映射
冻结换算与参数" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	holdout [label="另采独立书写批次
检查预测误差与重复性" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	pass [label="独立验证通过？" color="#A87926" fillcolor="#FFF6E3" margin="0.15,0.10" shape=diamond style=filled]
	glyph [label="同一工字的空白纸验证
比较笔宽、轮廓、端点与拖痕" color="#173E3A" fillcolor="#173E3A" fontcolor="#FFFFFF" shape=box style="rounded,filled"]
	investigate [label="定位条件或模型误差
核查含墨、零点与支撑
修订后重新采样" color="#B94C37" fillcolor="#FFF1E9" shape=box style="rounded,filled,dashed"]
	conditions -> design [label=""]
	design -> collect [label=""]
	collect -> measure [label=""]
	measure -> separable [label=""]
	separable -> fit [label="能"]
	separable -> investigate [label="不能" color="#B94C37" fontcolor="#9B4435" style=dashed]
	fit -> holdout [label=""]
	holdout -> pass [label=""]
	pass -> glyph [label="通过"]
	pass -> investigate [label="未通过" color="#B94C37" fontcolor="#9B4435" style=dashed]
	investigate -> conditions [label="" color="#B94C37" constraint=false fontcolor="#9B4435" style=dashed]
}