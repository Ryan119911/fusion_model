	input -> inverse [label=""]
	inverse -> candidates [label=""]
	candidates -> mapping [label=""]
	mapping -> write [label=""]
	write -> observe [label=""]
	observe -> measure [label="写后反馈" color="#B94C37" fontcolor="#9B4435" style=dashed]
	measure -> update [label="" color="#B94C37" fontcolor="#9B4435" style=dashed]
	update -> mapping [label="下一次指令" color="#B94C37" constraint=false fontcolor="#9B4435" style=dashed]
}