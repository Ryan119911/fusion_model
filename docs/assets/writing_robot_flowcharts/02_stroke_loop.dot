digraph "02_stroke_loop" {
	bgcolor="#F7F6F2" dpi=160 nodesep=0.5 outputorder=edgesfirst pad=0.35 rankdir=TB ranksep=0.45 splines=polyline
	node [fontcolor="#172725" fontname="Noto Sans CJK SC" fontsize=19 margin="0.22,0.16" penwidth=1.6]
	edge [arrowsize=0.8 color="#657F74" fontcolor="#4C6158" fontname="Noto Sans CJK SC" fontsize=15 penwidth=1.5]
	target [label="确定目标形态
中心线、沿程笔宽、轮廓与起收笔" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	calibration [label="建立可重复的局部响应
固定条件，标定下压 d → 笔宽 w" color="#B94C37" fillcolor="#FFF1E9" shape=box style="rounded,filled,dashed"]
	generate [label="生成并筛选可执行候选
局部逆映射＋起收笔参数
约束有效域、平滑性与机器人运动" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	write [label="实写一笔 → 抬笔拍照" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	measure [label="共同纸面尺度下测误差
位置、笔宽、轮廓与端点分别评价" color="#49776A" fillcolor="#EDF4F0" shape=box style="rounded,filled"]
	accept [label="满足预定质量
并通过独立重复？" color="#A87926" fillcolor="#FFF6E3" margin="0.15,0.10" shape=diamond style=filled]
	keep [label="保留参数与原始证据
进入同一工字验证" color="#173E3A" fillcolor="#173E3A" fontcolor="#FFFFFF" shape=box style="rounded,filled"]
	correct [label="按误差归因修正
位置 → XY／纸面
笔宽 → 下压；拖痕 → 收笔" color="#B94C37" fillcolor="#FFF1E9" shape=box style="rounded,filled,dashed"]
	valid [label="局部响应可靠
且仍在标定域内？" color="#A87926" fillcolor="#FFF6E3" margin="0.15,0.10" shape=diamond style=filled]
	recalibrate [label="补充观测或重新标定
不直接外推下压" color="#B94C37" fillcolor="#FFF1E9" shape=box style="rounded,filled,dashed"]
	target -> calibration [label=""]
	calibration -> generate [label=""]
	generate -> write [label=""]
	write -> measure [label=""]
	measure -> accept [label=""]
	accept -> keep [label="是"]
	accept -> correct [label="否" color="#B94C37" fontcolor="#9B4435" style=dashed]
	correct -> valid [label="" color="#B94C37" fontcolor="#9B4435" style=dashed]
	valid -> generate [label="是：小步更新" color="#B94C37" constraint=false fontcolor="#9B4435" style=dashed]
	valid -> recalibrate [label="否" color="#B94C37" fontcolor="#9B4435" style=dashed]
	recalibrate -> calibration [label="" color="#B94C37" constraint=false fontcolor="#9B4435" style=dashed]
}