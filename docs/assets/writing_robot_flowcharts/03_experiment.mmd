flowchart TB
    conditions["固定实验条件<br/>统一纸面零点、实心支撑<br/>姿态、速度与上墨流程保持一致"]
    design["首轮探索：三档重复短线<br/>d = 2.0／2.5／3.0 mm，各 3 条<br/>每条 25 mm；顺序交错、位置均衡"]
    collect["逐条独立上墨与书写<br/>保存实际指令、位姿与完整原图"]
    measure["共同尺度测量<br/>行笔宽度与波动<br/>起收笔、拖痕另行记录"]
    separable{"档间差异能否与<br/>同档波动区分？"}
    fit["拟合局部下压—笔宽映射<br/>冻结换算与参数"]
    holdout["另采独立书写批次<br/>检查预测误差与重复性"]
    pass{"独立验证通过？"}
    glyph["同一工字的空白纸验证<br/>比较笔宽、轮廓、端点与拖痕"]
    investigate["定位条件或模型误差<br/>核查含墨、零点与支撑<br/>修订后重新采样"]
    conditions --> design
    design --> collect
    collect --> measure
    measure --> separable
    separable -->|能| fit
    separable -.->|不能| investigate
    fit --> holdout
    holdout --> pass
    pass -->|通过| glyph
    pass -.->|未通过| investigate
    investigate -.-> conditions
    classDef base fill:#EDF4F0,stroke:#49776A,color:#172725;
    classDef planned fill:#FFF1E9,stroke:#B94C37,stroke-dasharray:5 3,color:#172725;
    classDef decision fill:#FFF6E3,stroke:#A87926,color:#172725;
    classDef ending fill:#173E3A,stroke:#173E3A,color:#FFFFFF;
    class conditions,design,collect,measure,fit,holdout base;
    class investigate planned;
    class separable,pass decision;
    class glyph ending;
